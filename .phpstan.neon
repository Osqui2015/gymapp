parameters:
    level: 5
    paths:
        - app
    bootstrapFiles:
        - vendor/autoload.php
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
    excludePaths:
        analyseAndScan:
            - app/Console/Commands/GenerateVapidKeys.php (?)
    ignoreErrors:
        # === Laravel magic: fillable, hidden, casts, dynamic properties ===
        # Acceder a Model->$atributo que no está declarado en la clase (viene
        # de la DB o de fillable). Es el caso normal de Eloquent.
        -
            message: '#Access to an undefined property App\\Models\\[A-Z][a-zA-Z]+::\$[a-z_]+#'
            path: app
        # === Eloquent query methods: whereHas, whereDoesntHave, withCount, etc. ===
        # phpstan 2.x sin la extensión de Laravel no detecta el query builder
        # fluent. Son métodos reales del Eloquent\Builder.
        -
            message: '#Call to an undefined static method App\\Models\\[A-Z][a-zA-Z]+::[a-zA-Z_]+\(\)#'
            path: app
        -
            message: '#Call to an undefined method Illuminate\\Database\\Eloquent\\Builder::[a-zA-Z_]+\(\)#'
            path: app
        # === Model dinámicos (created_at, updated_at, relations) ===
        -
            message: '#Access to an undefined property Illuminate\\Database\\Eloquent\\Model::\$[a-z_]+#'
            path: app
        # === auth() helper (no es Auth::id() sino auth()->id() en estos casos) ===
        -
            message: '#Call to an undefined method Illuminate\\Contracts\\Auth\\Factory::id\(\)#'
            path: app
        # === User::hasRole recibe string o array ===
        -
            message: '#Parameter .* of method App\\Models\\User::hasRole\(\) expects .*, .* given#'
            path: app
        # === Gate closures ===
        -
            message: '#Parameter .* of function array_merge expects array, .* given#'
            path: app
