{
    "name": "GymApp",
    "short_name": "GymApp",
    "description": "Tu app de entrenamiento, rutinas, progreso y comunicación con tu trainer.",
    "start_url": "/dashboard",
    "display": "standalone",
    "background_color": "#ffffff",
    "theme_color": "#4f46e5",
    "orientation": "portrait",
    "lang": "es",
    "icons": [
        {
            "src": "/favicon.ico",
            "sizes": "64x64 32x32 24x24 16x16",
            "type": "image/x-icon"
        },
        {
            "src": "/icons/icon-192x192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/icons/icon-512x512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/icons/icon-maskable-192x192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "/icons/icon-maskable-512x512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "shortcuts": [
        {
            "name": "Entrenar Hoy",
            "short_name": "Entrenar",
            "description": "Ir directo a la sesión de hoy",
            "url": "/dashboard",
            "icons": [{ "src": "/icons/icon-192x192.png", "sizes": "192x192", "type": "image/png" }]
        },
        {
            "name": "Mis Rutinas",
            "short_name": "Rutinas",
            "description": "Ver y organizar rutinas de entrenamiento",
            "url": "/rutinas",
            "icons": [{ "src": "/icons/icon-192x192.png", "sizes": "192x192", "type": "image/png" }]
        },
        {
            "name": "Historial de Series",
            "short_name": "Historial",
            "description": "Consultar historial y marcas",
            "url": "/historial",
            "icons": [{ "src": "/icons/icon-192x192.png", "sizes": "192x192", "type": "image/png" }]
        },
        {
            "name": "Progreso y Metas",
            "short_name": "Progreso",
            "description": "Ver evolución física y gráficos",
            "url": "/progreso",
            "icons": [{ "src": "/icons/icon-192x192.png", "sizes": "192x192", "type": "image/png" }]
        }
    ]
